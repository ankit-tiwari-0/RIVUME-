# =====================================
# RIVUME | 光
# Git Ignore Configuration
# =====================================

# Dependencies
node_modules/
**/node_modules/

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Build outputs
dist/
build/
.next/
out/
.nuxt/
.svelte-kit/
coverage/

# Cache
.cache/
.parcel-cache/
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Test coverage
.nyc_output/
*.lcov

# Package manager
.pnp.*
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# IDE and editors
.vscode/
!.vscode/extensions.json
.idea/
*.sublime*
*.swp

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# Temporary and backup files
*.tmp
*.temp
*.bak
*.backup
*.old

# Serverless
.serverless/
.webpack/

# Database files
*.sqlite
*.sqlite3

# Uploads and generated files
uploads/*
!uploads/.gitkeep